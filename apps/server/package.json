{
  "name": "@4am/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --sourcemap --outfile=dist/index.js --external:fastify --external:@fastify/cors --external:@fastify/static --external:better-sqlite3 --external:mongodb --external:ws --external:zod",
    "start": "node --enable-source-maps scripts/start.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@4am/mental-poker": "*",
    "@4am/shared": "*",
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.3.0",
    "@noble/hashes": "^1.5.0",
    "better-sqlite3": "^11.3.0",
    "fastify": "^5.0.0",
    "mongodb": "^7.5.0",
    "tsx": "^4.19.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.25.0"
  }
}
